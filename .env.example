APP_NAME=Logistics Website API
APP_ENV=development
DEBUG=true

# Development database. Change to a PostgreSQL URL for production.
DATABASE_URL=sqlite:///./logistics.db

SECRET_KEY=change-this-secret-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Reserved for Phase 2 seed/authentication work.
INITIAL_SUPER_ADMIN_NAME=Super Admin
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=change-this-before-seeding
